# ============================================================
# 全局环境变量配置
# ============================================================

# 项目名称（控制容器名前缀，避免多项目冲突）
COMPOSE_PROJECT_NAME=shop
APP_NAME=shop

# 应用版本（控制镜像标签）
APP_VERSION=1.0.0

# ==================== 端口配置 ====================
ADMIN_PORT=8081
API_PORT=8080
ADMIN_UI_PORT=5173

# ==================== 基础设施端口 ====================
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=9094
ES_PORT=9200
LOGSTASH_PORT=5044
KIBANA_PORT=5601

# ==================== JVM 参数 ====================
ADMIN_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
API_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC

# ==================== 数据库配置 ====================
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ==================== Redis 配置 ====================
REDIS_PASSWORD=

# ==================== JWT 配置 ====================
JWT_SECRET=shop-secret-key-for-jwt-token-generation
JWT_EXPIRATION=604800000
