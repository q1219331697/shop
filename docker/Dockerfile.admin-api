# ============================================================
# shop-admin-api Dockerfile
# 构建命令: docker build -t shop-admin-api:1.0.0 -f docker/Dockerfile.admin-api .
# ============================================================

# -------------------- 阶段1: Maven 构建 --------------------
FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /build

# 配置阿里云 Maven 镜像加速
COPY docker/maven/settings.xml /root/.m2/settings.xml

# 先复制 POM 文件，利用 Docker 缓存加速依赖下载
COPY backend/pom.xml ./
COPY backend/shop-common/pom.xml ./shop-common/
COPY backend/shop-dao/pom.xml ./shop-dao/
COPY backend/shop-service/pom.xml ./shop-service/

COPY backend/shop-admin-api/pom.xml ./shop-admin-api/
COPY backend/shop-app-api/pom.xml ./shop-app-api/

# 下载依赖
RUN mvn dependency:go-offline -pl shop-admin-api -am -B

# 复制源代码
COPY backend/shop-common/ ./shop-common/
COPY backend/shop-dao/ ./shop-dao/
COPY backend/shop-service/ ./shop-service/
COPY backend/shop-admin-api/ ./shop-admin-api/
COPY backend/shop-app-api/ ./shop-app-api/

# 构建 JAR
RUN mvn clean package -DskipTests -Dcheckstyle.skip=true -pl shop-admin-api -am -B

# -------------------- 阶段2: 运行镜像 --------------------
FROM eclipse-temurin:17-jre-alpine

LABEL maintainer="shop-team"
LABEL description="shop-admin-api 后台管理API服务"
LABEL version="1.0.0"

# 安装 curl 和时区支持
RUN sed -i "s/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g" /etc/apk/repositories && \
    apk add --no-cache curl tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    apk del tzdata

# 创建非 root 用户
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# 复制 JAR 文件
COPY --from=builder --chown=appuser:appgroup /build/shop-admin-api/target/shop-admin-api-*.jar app.jar

USER appuser

EXPOSE 8081

ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC"

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8081/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS} -jar app.jar"]