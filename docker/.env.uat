# ============================================================
# UAT 环境变量配置
# ============================================================

# 项目名称（控制容器名前缀，避免多项目冲突）
APP_NAME=shop-uat
# Docker Compose项目名称（重要：不要删除或修改，用于容器命名和网络隔离）
COMPOSE_PROJECT_NAME=shop-uat

# 应用版本（控制镜像标签）
APP_VERSION=1.0.0

# ==================== 端口配置 ====================
ADMIN_PORT=18081
API_PORT=18080
ADMIN_UI_PORT=15173

# ==================== 基础设施端口 ====================
MYSQL_PORT=13306
REDIS_PORT=16379
RABBITMQ_PORT=15673
RABBITMQ_MGMT_PORT=15674
KAFKA_PORT=19092
KAFKA_EXTERNAL_PORT=19094
ES_PORT=19200
LOGSTASH_PORT=15044
KIBANA_PORT=15601

# ==================== JVM 参数 ====================
ADMIN_JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
API_JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# ==================== 数据库配置 ====================
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ==================== Redis 配置 ====================
REDIS_PASSWORD=

# ==================== JWT 配置 ====================
JWT_SECRET=shop-uat-secret-key-for-jwt-token-generation
JWT_EXPIRATION=604800000
