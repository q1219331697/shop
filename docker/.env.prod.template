# ============================================================
# 生产环境变量配置模板
# 使用方式: 复制此文件为 .env.prod 并修改配置值
#   cp .env.prod.template .env.prod
#   ./deploy.sh -e prod app
# ============================================================

# 项目名称（生产环境隔离）
APP_NAME=shop-prod
# Docker Compose项目名称（重要：不要删除或修改，用于容器命名和网络隔离）
COMPOSE_PROJECT_NAME=shop-prod

# 应用版本
APP_VERSION=1.0.0

# ==================== 端口配置 ====================
ADMIN_PORT=8081
API_PORT=8080
ADMIN_UI_PORT=80

# ==================== 基础设施端口 ====================
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=9094
ES_PORT=9200
LOGSTASH_PORT=5044
KIBANA_PORT=5601

# ==================== JVM 参数（生产环境建议调大） ====================
ADMIN_JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/heapdump.hprof
API_JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/heapdump.hprof

# ==================== 数据库配置（⚠️ 必须修改） ====================
MYSQL_USERNAME=root
MYSQL_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# ==================== Redis 配置（⚠️ 必须修改） ====================
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE

# ==================== JWT 配置（⚠️ 必须修改） ====================
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_KEY_AT_LEAST_32_CHARS
JWT_EXPIRATION=604800000
