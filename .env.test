# ============================================================
# Shop 应用 - 测试环境配置
#
# 使用方法：
#   docker compose --env-file .env.test -p shop-test up -d
# ============================================================

# ==================== 项目名称 ====================
APP_NAME=shop-test
COMPOSE_PROJECT_NAME=shop-test

# ==================== 应用版本 ====================
APP_VERSION=1.0.0

# ==================== 端口配置 ====================
ADMIN_PORT=18081
API_PORT=18080
ADMIN_UI_PORT=18000

# ==================== 基础设施端口 ====================
MYSQL_PORT=13306
REDIS_PORT=16379
KAFKA_PORT=19092
KAFKA_EXTERNAL_PORT=19094
ES_PORT=19200
ES_COORD_PORT=19300
LOGSTASH_PORT=15044
LOGSTASH_REPORTING_PORT=15960
RABBITMQ_PORT=15672
RABBITMQ_MGMT_PORT=15673
KIBANA_PORT=15601
KIBANA_EXT_PORT=15601

# ==================== JVM 参数（测试环境 - 中等内存） ====================
ADMIN_JAVA_OPTS=-Xms512m -Xmx1g -XX:+UseG1GC
API_JAVA_OPTS=-Xms512m -Xmx1g -XX:+UseG1GC

# ==================== 数据库配置 ====================
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ==================== Redis 配置 ====================
REDIS_PASSWORD=

# ==================== JWT 配置 ====================
JWT_SECRET=shop-test-secret-key
JWT_EXPIRATION=604800000

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_KAFKA_ENABLED=false