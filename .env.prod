# ============================================================
# Shop 应用 - 生产环境配置
#
# ⚠️ 安全警告：此文件包含敏感信息，已添加到 .gitignore
# 从模板复制：cp .env.prod.template .env.prod
# 必须修改以下配置：
#   - MYSQL_PASSWORD
#   - REDIS_PASSWORD
#   - JWT_SECRET
# ============================================================

# ==================== 项目名称 ====================
APP_NAME=shop-prod
COMPOSE_PROJECT_NAME=shop-prod

# ==================== 应用版本 ====================
APP_VERSION=1.0.0

# ==================== 端口配置 ====================
ADMIN_PORT=28081
API_PORT=28080
ADMIN_UI_PORT=28000

# ==================== 基础设施端口 ====================
MYSQL_PORT=23306
REDIS_PORT=26379
KAFKA_PORT=29092
KAFKA_EXTERNAL_PORT=29094
ES_PORT=29200
ES_COORD_PORT=29300
LOGSTASH_PORT=29044
LOGSTASH_REPORTING_PORT=29960
RABBITMQ_PORT=25672
RABBITMQ_MGMT_PORT=25673
KIBANA_PORT=29601
KIBANA_EXT_PORT=29601

# ==================== JVM 参数（生产环境 - 高内存） ====================
ADMIN_JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200
API_JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ==================== 数据库配置（⚠️ 必须修改） ====================
MYSQL_USERNAME=root
MYSQL_PASSWORD=root123

# ==================== Redis 配置（⚠️ 必须修改） ====================
REDIS_PASSWORD=

# ==================== JWT 配置（⚠️ 必须修改） ====================
JWT_SECRET=CHANGE_THIS_JWT_SECRET_KEY_AT_LEAST_32_CHARS
JWT_EXPIRATION=604800000

# ==================== 日志配置 ====================
LOG_LEVEL=WARN
LOG_KAFKA_ENABLED=true

# ==================== 资源限制配置 ====================
MYSQL_MEMORY_LIMIT=1g
MYSQL_CPU_LIMIT=1

REDIS_MEMORY_LIMIT=512m
REDIS_CPU_LIMIT=1

KAFKA_MEMORY_LIMIT=1g
KAFKA_CPU_LIMIT=2

# ==================== 监控配置 ====================
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_START_PERIOD=60s
HEALTHCHECK_RETRIES=3

JMX_ENABLED=true
JMX_PORT=9010