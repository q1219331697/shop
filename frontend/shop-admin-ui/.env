# 通用环境变量 —— 这里列出项目全部可配置 key（值可留空，由各环境文件填写/覆盖）
VITE_APP_TITLE=商城管理后台

# API请求前缀（所有请求自动加上此前缀，配合Vite代理使用；生产由 nginx 按同名前缀反代）
VITE_API_PREFIX=/api

# 后端API地址（vite 代理目标）——留空，由各环境填写：
#   .env.development / .env.preview → http://localhost:8081
#   .env.production                → 留空（前后端同源，由 nginx 反代）
VITE_API_BASE_URL=
