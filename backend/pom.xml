<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  商城项目根 POM 文件（多模块聚合，统一管理依赖版本与构建配置）
  ============================================================
  后端构建与验证约定（AI / 协作者必读，勿跳过）：
  1. Checkstyle 校验：使用 Maven 验证，严禁跳过。
     - 快速校验：         mvn -o checkstyle:check
     - 完整构建（含校验）： mvn clean package -pl shop-admin-api -am -DskipTests
     - 禁止 -Dcheckstyle.skip，校验不通过则构建失败。
  2. 运行 / 重启后端：使用 Docker 重建镜像并启动（自动拉起 mysql、redis）。
     - 重建镜像： docker compose build shop-admin-api
     - 启动容器： docker compose up -d shop-admin-api
     - 仅重启容器： docker compose restart shop-admin-api
     （以上命令在仓库根目录执行）
  3. 响应约定：所有接口 HTTP 状态码恒为 200，成功/失败仅由响应体 code 区分
     （SUCCESS=000000，参数错误=PARAM_ERROR=000002）。
     校验失败统一返回 Result.error(ResultCodeEnum.PARAM_ERROR, 文案)，不使用 4xx/5xx。
     详见仓库根 AI.md 第 4 节。
  ============================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Maven 模型版本 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 父项目，统一管理 Spring Boot 相关依赖版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <!-- 项目坐标信息 -->
    <groupId>com.shop</groupId>
    <artifactId>shop</artifactId>
    <version>1.0.0</version>
    <!-- 聚合项目，打包类型为 pom -->
    <packaging>pom</packaging>
    <name>shop</name>
    <description>Spring Boot Shopping Mall Project</description>

    <!-- ==================== 子模块定义 ==================== -->
    <modules>
        <!-- 后台管理模块 -->
        <module>shop-admin-api</module>
        <!-- 移动端API模块 -->
        <module>shop-app-api</module>
        <!-- 公共模块（工具类、常量、通用实体等） -->
        <module>shop-common</module>
        <!-- 数据访问层模块（Mapper/DAO） -->
        <module>shop-dao</module>
        <!-- 业务逻辑层模块（Service） -->
        <module>shop-service</module>
    </modules>

    <!-- ==================== 全局属性配置 ==================== -->
    <properties>
        <!-- Java 版本 -->
        <java.version>17</java.version>
        <!-- 项目源码编码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 项目报告输出编码 -->
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Maven 编译器编码 -->
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <!-- 文件编码 -->
        <file.encoding>UTF-8</file.encoding>

        <!-- Hutool 工具库版本 -->
        <hutool.version>5.8.47</hutool.version>
        <!-- JWT 令牌版本 -->
        <jwt.version>0.12.7</jwt.version>
        <!-- Knife4j API 文档版本 -->
        <knife4j.version>5.7.5</knife4j.version>
        <!-- MyBatis Plus 版本 -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
    </properties>

    <!-- ==================== 依赖版本管理（子模块按需引入，不直接引入依赖） ==================== -->
    <dependencyManagement>
        <dependencies>
            <!-- ==================== 项目内部模块 ==================== -->
            <!-- 公共模块 -->
            <dependency>
                <groupId>com.shop</groupId>
                <artifactId>shop-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 数据访问层模块 -->
            <dependency>
                <groupId>com.shop</groupId>
                <artifactId>shop-dao</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 业务逻辑层模块 -->
            <dependency>
                <groupId>com.shop</groupId>
                <artifactId>shop-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ==================== 数据层 ==================== -->
            <!-- MyBatis Plus BOM（物料清单，统一管理 MyBatis Plus 相关依赖版本） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ==================== 安全与认证 ==================== -->
            <!-- JWT 实现（jjwt-impl 会自动传递依赖 jjwt-api） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jwt.version}</version>
            </dependency>
            <!-- JWT Jackson 序列化支持 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jwt.version}</version>
            </dependency>

            <!-- ==================== 工具库 ==================== -->
            <!-- Hutool 工具库 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- ==================== API 文档 ==================== -->
            <dependency>
                <groupId>com.baizhukui</groupId>
                <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ==================== 全局依赖（所有子模块继承，统一日志方案） ==================== -->
    <dependencies>
        <!--
            统一排除 Spring Boot 默认日志 starter（spring-boot-starter-logging，内含 Logback + log4j-to-slf4j）。
            所有 spring-boot-starter-* 均经由 spring-boot-starter 引入它，此处一次性排除即全项目生效，
            无需在每个 starter 上重复写 exclusion。
            日志实现（Log4j2）同样在此统一声明，使所有模块（含库模块跑单测）都能拿到日志实现；
            各子模块无需再重复声明 spring-boot-starter-log4j2。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Log4j2 日志实现（与上面的排除配套，全局统一） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
    </dependencies>

    <!-- ==================== 构建配置 ==================== -->
    <build>
        <plugins>
            <!--
                Checkstyle 插件：代码风格检查（编译时强制执行，不通过则构建失败）
                全量检查：mvn validate
                单模块：  mvn validate -pl shop-admin
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <configLocation>code-quality/checkstyle/checkstyle.xml</configLocation>
                    <suppressionsLocation>code-quality/checkstyle/suppressions.xml</suppressionsLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                    <!--
                        实体类字段 Javadoc 专项检查：仅针对 entity 包下的文件（**/entity/**/*.java），
                        强制所有字段（含 private）必须有 Javadoc。规则文件：code-quality/checkstyle/checkstyle-entity.xml
                    -->
                    <execution>
                        <id>entity-field-javadoc</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <configLocation>code-quality/checkstyle/checkstyle-entity.xml</configLocation>
                            <includes>**/entity/**/*.java</includes>
                            <consoleOutput>true</consoleOutput>
                            <failsOnError>true</failsOnError>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Jacoco 插件：单元测试覆盖率统计（mvn test 时自动生成报告）
                全量覆盖率：mvn test
                单模块：    mvn test -pl shop-admin
                跳过测试：  mvn compile -DskipTests
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.10</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>