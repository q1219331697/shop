<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~ 后台管理模块
  ~ 提供管理端 REST 接口，包含商品管理、订单管理、用户管理等功能
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Maven 模型版本 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承商城根项目 -->
    <parent>
        <groupId>com.shop</groupId>
        <artifactId>shop</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>shop-admin-api</artifactId>
    <name>shop-admin-api</name>
    <description>后台管理模块 - 管理端REST接口</description>

    <dependencies>
        <!-- ==================== 项目内部模块 ==================== -->
        <!-- 依赖数据访问层模块：提供 MyBatis-Plus 分页插件与字段自动填充等基础设施 -->
        <dependency>
            <groupId>com.shop</groupId>
            <artifactId>shop-dao</artifactId>
        </dependency>

        <!-- Liquibase 支持：starter 聚合了自动配置模块 spring-boot-liquibase，后者已以 compile 依赖引入 liquibase-core 引擎；版本由 spring-boot-dependencies BOM 统一管理 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>

        <!-- ==================== Spring Boot 核心 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验框架 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ==================== 数据层 ==================== -->
        <!-- Redis 缓存 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ==================== 安全与认证 ==================== -->
        <!-- Spring Security 安全框架 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ==================== 消息队列 ==================== -->
        <!-- Kafka 客户端（Log4j2 Kafka Appender 需要） -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>

        <!-- ==================== 运维监控 ==================== -->
        <!-- Spring Boot Actuator（生产级监控与管理端点） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- AOP（@Aspect 操作日志切面依赖；Spring Boot 4 起 spring-boot-starter-aop 已更名为 spring-boot-starter-aspectj） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- ==================== 开发工具 ==================== -->
        <!-- Lombok 注解处理器 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <!-- ==================== 构建配置 ==================== -->
    <build>
        <plugins>
            <!-- Spring Boot Maven 打包插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>