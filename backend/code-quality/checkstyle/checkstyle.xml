<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle configuration for Java project
    基于Google Java Style Guide，并做适当调整
-->

<module name="Checker">
    <!-- 检查文件编码 -->
    <property name="charset" value="UTF-8"/>

    <!-- 检查文件是否包含tab字符 -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- 检查文件长度 -->
    <module name="FileLength">
        <property name="max" value="2000"/>
    </module>

    <!-- 检查行长度 -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <!-- 检查文件中是否包含package-info.java -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Line has trailing spaces."/>
    </module>

    <!-- 文件开始不允许有空行（文件首行不能是空行或纯空白行） -->
    <module name="RegexpMultiline">
        <property name="format" value="\A[ \t]*\r?\n"/>
        <property name="matchAcrossLines" value="true"/>
        <property name="message" value="文件开始不要空行"/>
    </module>

    <module name="TreeWalker">
        <!-- 检查命名规范 -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="LocalFinalVariableName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <module name="PackageName"/>
        <module name="ParameterName"/>
        <module name="StaticVariableName"/>
        <!-- 检查类命名规范：驼峰命名 -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <property name="tokens" value="CLASS_DEF"/>
        </module>
        <!-- 检查枚举类命名规范：必须以Enum结尾，驼峰命名 -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*Enum$"/>
            <property name="tokens" value="ENUM_DEF"/>
        </module>

        <!-- 检查导入 -->
        <!-- 禁止 * 通配导入（比 OpenJDK 的「最多 1 个」更严，全禁） -->
        <module name="AvoidStarImport"/>
        <module name="IllegalImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <!-- import 顺序：分组顺序 java -> javax -> jakarta -> org -> com -> 其余，
             组内按 ASCII 字母序；静态导入统一置于底部；组间必须空一行、组内不允许空行 -->
        <module name="ImportOrder">
            <property name="groups" value="java,javax,jakarta,org,com"/>
            <property name="ordered" value="true"/>
            <property name="separated" value="true"/>
            <property name="option" value="bottom"/>
            <property name="staticGroups" value="java,javax,jakarta,org,com"/>
            <property name="sortStaticImportsAlphabetically" value="true"/>
        </module>
        <!-- package / import / static import 语句禁止换行（OpenJDK 风格） -->
        <module name="NoLineWrap">
            <property name="tokens" value="PACKAGE_DEF, IMPORT, STATIC_IMPORT"/>
        </module>
        <!-- 禁止使用全限定类名，应使用import语句 -->
        <!-- 检测变量声明中的全限定类名：com.xxx.ClassName var = -->
        <module name="Regexp">
            <property name="format" value="\b[a-z]\w*(\.[a-z]\w*)+\.[A-Z]\w*\s+\w+\s*="/>
            <property name="message" value="禁止使用全限定类名声明变量（如 com.xxx.ClassName var =），请使用import语句导入后使用简单类名"/>
            <property name="illegalPattern" value="true"/>
        </module>
        <!-- 检测new实例化中的全限定类名：new com.xxx.ClassName() -->
        <module name="Regexp">
            <property name="format" value="new\s+[a-z]\w*(\.[a-z]\w*)+\.[A-Z]\w*(&lt;[^>]*&gt;)?\s*\("/>
            <property name="message" value="禁止使用全限定类名实例化（如 new com.xxx.ClassName()），请使用import语句导入后使用简单类名"/>
            <property name="illegalPattern" value="true"/>
        </module>
        <!-- 检测注解中的全限定类名：@com.xxx.Annotation -->
        <module name="Regexp">
            <property name="format" value="@[a-z]\w*(\.[a-z]\w*)+\.[A-Z]\w*"/>
            <property name="message" value="禁止使用全限定类名注解（如 @com.xxx.Annotation），请使用import语句导入后使用简单类名"/>
            <property name="illegalPattern" value="true"/>
        </module>

        <!-- MyBatis相关规则 -->
        <!-- 禁止使用MyBatis的@Select注解 -->
        <module name="Regexp">
            <property name="format" value="@(\w+\.)*Select\s*\("/>
            <property name="message" value="禁止在Java代码中使用@Select注解，请将SQL语句写在XML映射文件中"/>
            <property name="illegalPattern" value="true"/>
        </module>
        <!-- 禁止使用MyBatis的@Update注解 -->
        <module name="Regexp">
            <property name="format" value="@(\w+\.)*Update\s*\("/>
            <property name="message" value="禁止在Java代码中使用@Update注解，请将SQL语句写在XML映射文件中"/>
            <property name="illegalPattern" value="true"/>
        </module>
        <!-- 禁止使用MyBatis的@Insert注解 -->
        <module name="Regexp">
            <property name="format" value="@(\w+\.)*Insert\s*\("/>
            <property name="message" value="禁止在Java代码中使用@Insert注解，请将SQL语句写在XML映射文件中"/>
            <property name="illegalPattern" value="true"/>
        </module>
        <!-- 禁止使用MyBatis的@Delete注解 -->
        <module name="Regexp">
            <property name="format" value="@(\w+\.)*Delete\s*\("/>
            <property name="message" value="禁止在Java代码中使用@Delete注解，请将SQL语句写在XML映射文件中"/>
            <property name="illegalPattern" value="true"/>
        </module>

        <!-- 检查大小写 -->
        <module name="UpperEll"/>

        <!-- 检查代码块 -->
        <module name="EmptyBlock"/>
        <module name="LeftCurly"/>
        <module name="NeedBraces"/>
        <module name="RightCurly"/>
        <module name="AvoidNestedBlocks"/>

        <!-- 检查代码长度 -->
        <module name="MethodLength">
            <property name="max" value="150"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="7"/>
        </module>

        <!-- 检查空格 -->
        <module name="EmptyForIteratorPad"/>
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="NoWhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="OperatorWrap"/>
        <module name="ParenPad"/>
        <module name="TypecastParenPad"/>
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround"/>

        <!-- 检查修饰符 -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- 检查编码问题 -->
        <module name="ArrayTrailingComma"/>
        <module name="CovariantEquals"/>
        <module name="DefaultComesLast"/>
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="ExplicitInitialization"/>
        <module name="FallThrough"/>
        <module name="HiddenField">
            <property name="ignoreConstructorParameter" value="true"/>
            <property name="ignoreSetter" value="true"/>
        </module>
        <module name="IllegalInstantiation"/>
        <module name="InnerAssignment"/>
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
        </module>
        <module name="MissingSwitchDefault"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>
        <module name="NestedForDepth">
            <property name="max" value="2"/>
        </module>
        <module name="NestedTryDepth">
            <property name="max" value="2"/>
        </module>
        <module name="NoClone"/>
        <module name="NoFinalizer"/>
        <module name="OneStatementPerLine"/>
        <module name="OverloadMethodsDeclarationOrder"/>
        <module name="PackageDeclaration"/>
        <module name="ParameterAssignment"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="SuperClone"/>
        <module name="SuperFinalize"/>

        <!-- 检查Javadoc注释 -->
        <!-- 方法必须有说明、参数说明、返回值说明，且必须是多行Javadoc -->
        <module name="JavadocMethod">
            <property name="allowMissingParamTags" value="false"/>
            <property name="allowMissingReturnTag" value="false"/>
        </module>
        <!-- 禁止单行Javadoc（/** xxx */），强制多行格式 -->
        <module name="SingleLineJavadoc"/>
        <module name="JavadocType">
            <property name="scope" value="public"/>
        </module>
        <module name="JavadocVariable">
            <property name="scope" value="public"/>
        </module>

        <!-- 后端文件强制规范：类/接口/枚举 Javadoc 必须包含 @author 与 @since 标签，
             并遵循 Oracle Javadoc 行业标准：顺序为 @author 在前、@since 在后；
             排版为「描述与标签组之间空一行，标签组内部紧凑（标签之间不空行）」 -->
        <module name="Regexp">
            <property name="format" value="@author shop"/>
            <property name="message" value="后端文件必须在类 Javadoc 中包含 @author shop"/>
            <property name="illegalPattern" value="false"/>
        </module>
        <module name="Regexp">
            <property name="format" value="@since 1\.0\.0"/>
            <property name="message" value="后端文件必须在类 Javadoc 中包含 @since 1.0.0"/>
            <property name="illegalPattern" value="false"/>
        </module>
        <!-- @author（标签组首标签）前必须与上方描述空一行 -->
        <module name="Regexp">
            <property name="format" value="\n\s*\*\s*\n\s*\*\s*@author shop"/>
            <property name="message" value="@author 标签前必须与上方注释空一行"/>
            <property name="illegalPattern" value="false"/>
        </module>
        <!-- @since 必须位于 @author 之后（Oracle 行业标准顺序；标签组内部紧凑，不强制标签间空行） -->
        <module name="Regexp">
            <property name="format" value="@author shop[\s\S]*?@since 1\.0\.0"/>
            <property name="message" value="@since 必须位于 @author 之后（Oracle Javadoc 行业标准顺序）"/>
            <property name="illegalPattern" value="false"/>
        </module>

        <!-- 检查常见编码问题 -->
        <module name="MissingDeprecated"/>
        <module name="AnnotationLocation">
            <property name="allowSamelineMultipleAnnotations" value="false"/>
            <property name="allowSamelineSingleParameterlessAnnotation" value="false"/>
            <property name="allowSamelineParameterizedAnnotation" value="false"/>
        </module>
    </module>
</module>
