<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j2日志配置文件（Spring Boot专用版）

  文件命名说明：
    本文件命名为 log4j2-spring.xml（带 -spring 后缀），而非 log4j2.xml，原因如下：
    1. Spring Boot 会识别 -spring 后缀，延迟加载此配置文件，等待 Spring Environment 就绪后再初始化
    2. 因此支持 ${spring:属性名} 语法，可直接引用 Spring 配置属性（如 spring.application.name）
    3. 支持 Spring Profile 切换（如 <Routes pattern="${spring:profiles.active}">）
    4. 如果命名为 log4j2.xml，Spring Boot 会在 Spring 初始化之前加载，${spring:...} 将无法解析

  配置说明：
    1. status: 日志框架自身的日志级别，可选值：TRACE, DEBUG, INFO, WARN, ERROR, FATAL, OFF
    2. monitorInterval: 自动检测配置文件变化的时间间隔（秒），设置为30表示每30秒检测一次

  参数覆盖方式：
    1. 直接修改下面的属性值
    2. JVM参数覆盖: java -Dapp.log.kafka.bootstrap-servers=xxx -jar xxx.jar
    3. 环境变量覆盖: export APP_LOG_KAFKA_BOOTSTRAP_SERVERS=xxx
    4. Spring配置覆盖: 在application.yml中设置 app.log.kafka.bootstrap-servers: xxx
-->
<Configuration status="WARN" monitorInterval="30">

    <!--
      Appenders（输出器）定义区域
      定义日志输出的目的地，如控制台、文件、Kafka等
    -->
    <Appenders>
        <!--
          控制台输出器
          name: Appender的名称，供Loggers引用
          target: 输出目标，SYSTEM_OUT表示标准输出
        -->
        <Console name="Console" target="SYSTEM_OUT">
            <!--
              PatternLayout: 模式布局，定义日志输出格式
              pattern: 日志格式模式
                %d{yyyy-MM-dd HH:mm:ss.SSS} - 日期时间，精确到毫秒
                [%t] - 线程名称
                %level - 日志级别，左对齐，宽度为5
                %logger{36} - Logger名称，最长36个字符
                %msg - 日志消息
                %n - 换行符
            -->
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!--
          Kafka输出器
          name: Appender的名称
          topic: Kafka主题名称
          syncSend: 是否同步发送
        -->
        <Kafka name="Kafka" topic="shop-logs" syncSend="false">
            <!--
              Kafka专用的日志格式
              %d{ISO8601} - ISO8601时间格式（如 2026-05-11T19:53:23.608+08:00）
              %C - 类名
              %M - 方法名
              %L - 行号
              [%t] - 线程名称
              %level - 日志级别
              %msg - 日志消息
            -->
            <!-- ${spring:spring.application.name} 读取 Spring 配置中的 spring.application.name 属性 -->
            <!-- 此语法依赖 -spring 后缀命名，否则会报 IllegalStateException -->
            <PatternLayout pattern="[%d{ISO8601}] [${spring:spring.application.name}] [%t] [%level] [%C.%M(%L)] - [%msg%n]" charset="UTF-8"/>
            <!-- bootstrap.servers: Kafka服务器地址 -->
            <Property name="bootstrap.servers">${spring:app.log.kafka.bootstrap-servers}</Property>
        </Kafka>
    </Appenders>

    <!--
      Loggers（日志记录器）定义区域
      定义不同包或类的日志级别和使用的Appender
    -->
    <Loggers>
        <!--
          根日志记录器
          level: 日志级别
          所有未单独配置的Logger都继承此配置
        -->
        <Root level="INFO">
            <!-- 引用Console和Kafka两个Appender，表示日志同时输出到控制台和Kafka -->
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Kafka"/>
        </Root>
        <!--
          MyBatis-Plus日志记录器
          DEBUG级别会输出SQL语句和参数信息，便于调试
        -->
        <Logger name="com.baomidou.mybatisplus" level="${spring:app.log.level.mybatis-plus}"/>
        <!--
          应用程序日志记录器
          配置项目包（com.shop）的日志级别
        -->
        <Logger name="com.shop" level="${spring:app.log.level.app}"/>
    </Loggers>
</Configuration>
