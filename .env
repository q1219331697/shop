# ============================================================
# Shop 应用 - 开发环境配置
#
# 使用方法：
#   docker compose up -d --build
#
# ============================================================

# ==================== 项目名称 ====================
APP_NAME=shop
COMPOSE_PROJECT_NAME=shop

# ==================== 应用版本 ====================
APP_VERSION=1.0.0

# ==================== 端口配置 ====================
ADMIN_PORT=8081
API_PORT=8080
ADMIN_UI_PORT=8000

# ==================== 基础设施端口 ====================
MYSQL_PORT=3306
REDIS_PORT=6379
KAFKA_PORT=9092
ES_PORT=9200
LOGSTASH_PORT=5044
KIBANA_PORT=5601

# ==================== JVM 参数（开发环境 - 低内存） ====================
ADMIN_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
API_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC

# ==================== 数据库配置 ====================
MYSQL_USERNAME=root
MYSQL_PASSWORD=root123

# ==================== Redis 配置 ====================
REDIS_PASSWORD=

# ==================== JWT 配置 ====================
JWT_SECRET=shop-secret-key
JWT_EXPIRATION=604800000

# ==================== 日志配置 ====================
LOG_LEVEL=INFO