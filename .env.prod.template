# ============================================================
# Shop 应用 - 生产环境配置模板
#
# 使用方法：
#   1. 复制此文件为 .env.prod：cp .env.prod.template .env.prod
#   2. 编辑 .env.prod 修改配置值（必须修改敏感配置）
#   3. 部署生产环境：
#      cd docker
#      docker compose --env-file ../../.env.prod up -d
#
# ⚠️ 安全提醒：生产环境必须修改以下配置，切勿使用模板默认值！
# ============================================================

# ==================== 项目名称 ====================
APP_NAME=shop-prod
COMPOSE_PROJECT_NAME=shop-prod

# ==================== 应用版本 ====================
APP_VERSION=1.0.0

# ==================== 端口配置 ====================
ADMIN_PORT=28081
API_PORT=28080
ADMIN_UI_PORT=28000

# ==================== 基础设施端口 ====================
MYSQL_PORT=23306
REDIS_PORT=26379
KAFKA_PORT=29092
KAFKA_EXTERNAL_PORT=29094
ES_PORT=29200
LOGSTASH_PORT=29044
KIBANA_PORT=29601

# ==================== JVM 参数（生产环境 - 高内存） ====================
# 推荐参数说明：
# -Xms1g -Xmx2g: 初始堆内存1G，最大2G，可根据实际负载调整
# -XX:+UseG1GC: 使用G1垃圾回收器，适合大堆内存
# -XX:MaxGCPauseMillis=200: 目标最大GC暂停时间200ms
# -XX:+HeapDumpOnOutOfMemoryError: OOM时自动生成堆转储
# -XX:HeapDumpPath=/app/logs/heapdump.hprof: 堆转储文件路径
# -XX:+PrintGCDetails: 打印GC详细信息
# -XX:+PrintGCDateStamps: 打印GC时间戳
# -Xloggc:/app/logs/gc.log: GC日志输出到文件

ADMIN_JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/heapdump.hprof -XX:+PrintGCDetails -XX:+PrintGCDateStamps -Xloggc:/app/logs/gc.log
API_JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/heapdump.hprof -XX:+PrintGCDetails -XX:+PrintGCDateStamps -Xloggc:/app/logs/gc.log

# ==================== 数据库配置（⚠️ 必须修改） ====================
# 建议使用强密码，并定期更换
MYSQL_USERNAME=root
MYSQL_PASSWORD=YOUR_STRONG_MYSQL_PASSWORD_HERE

# ==================== Redis 配置（⚠️ 必须修改） ====================
# 建议使用强密码，并启用认证
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE

# ==================== JWT 配置（⚠️ 必须修改） ====================
# JWT密钥必须至少32个字符，且不泄露
# 建议使用随机生成的密钥，可使用以下命令生成：
#   openssl rand -base64 48
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_KEY_AT_LEAST_32_CHARS
JWT_EXPIRATION=604800000

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_KAFKA_ENABLED=true

# ==================== 资源限制配置 ====================
# MySQL 配置
MYSQL_MEMORY_LIMIT=1g
MYSQL_CPU_LIMIT=1

# Redis 配置
REDIS_MEMORY_LIMIT=512m
REDIS_CPU_LIMIT=1

# Kafka 配置
KAFKA_MEMORY_LIMIT=1g
KAFKA_CPU_LIMIT=2

# ==================== 监控配置 ====================
# 健康检查配置
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_START_PERIOD=60s
HEALTHCHECK_RETRIES=3

# JVM 监控配置
JMX_ENABLED=true
JMX_PORT=9010